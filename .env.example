# PostgreSQL de desarrollo (no usar contraseñas reales en Git)
DATABASE_URL="postgresql://dev_user:change-me@127.0.0.1:5432/smart_menu_dev?schema=public"

# OAuth, configurar solo mediante Railway Variables u otro gestor de secretos
# AUTH_SECRET="generar_secreto_largo_con_herramientas_de_authjs"
# AUTH_GOOGLE_ID="id_de_cliente_oauth"
# AUTH_GOOGLE_SECRET="secreto_de_cliente_oauth"
# AUTH_TRUST_HOST="true" # únicamente detrás de proxy HTTPS de confianza

# E2E_TEST_SEED=1  # SOLO para base de datos de CI desechable

# Acceso básico de demostración: solo requiere AUTH_SECRET y base PostgreSQL.
# Bootstrap de propietario, usar solo una vez y eliminar variables inmediatamente:
# BOOTSTRAP_CONFIRM=CREATE_FIRST_OWNER
# BOOTSTRAP_EMAIL=propietario@example.com
# BOOTSTRAP_PASSWORD=long-secret-generated-outside-git
# BOOTSTRAP_RESTAURANT_NAME=Restaurante de prueba
# BOOTSTRAP_RESTAURANT_SLUG=restaurante-de-prueba
