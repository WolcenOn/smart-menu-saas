generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  SOLD_OUT
}

// White-listed presets only: never store arbitrary CSS or HTML supplied by tenants.
enum RestaurantThemePreset {
  OLIVE
  TERRACOTTA
  OCEAN
  NOIR
}

enum RestaurantRole {
  OWNER
  EDITOR
  WAITER
}

enum MenuLayout {
  CARDS
  LIST
}

model Restaurant {
  id          String                @id @default(cuid())
  slug        String                @unique @db.VarChar(80)
  name        String                @db.VarChar(160)
  tagline     String                @default("") @db.VarChar(180)
  themePreset RestaurantThemePreset @default(OLIVE)
  menuLayout  MenuLayout            @default(CARDS)
  timezone    String                @default("Europe/Madrid") @db.VarChar(64)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  menus       Menu[]
  members     RestaurantMember[]
}

model Menu {
  id           String     @id @default(cuid())
  restaurantId String
  name         String     @db.VarChar(120)
  published    Boolean    @default(false)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories   MenuCategory[]
  @@index([restaurantId, published])
}

model MenuCategory {
  id       String @id @default(cuid())
  menuId   String
  name     String @db.VarChar(100)
  position Int    @default(0)
  menu     Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dishes   Dish[]
  @@index([menuId, position])
}

model Dish {
  id                  String             @id @default(cuid())
  categoryId          String
  name                String             @db.VarChar(160)
  description         String             @default("") @db.VarChar(1200)
  price               Decimal            @db.Decimal(9, 2)
  status              DishStatus         @default(DRAFT)
  availability        AvailabilityStatus @default(AVAILABLE)
  allergensReviewedAt DateTime?
  position            Int                @default(0)
  category            MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allergens           DishAllergen[]
  imageKey            String?             @db.VarChar(300)
  imageUploads        DishImageUpload[]
  @@index([categoryId, status, position])
}

model Allergen {
  id     String @id @db.VarChar(40)
  name   String @unique @db.VarChar(100)
  dishes DishAllergen[]
}

model DishAllergen {
  dishId     String
  allergenId String
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)
  @@id([dishId, allergenId])
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  emailVerified DateTime?
  passwordHash  String?             @db.VarChar(100)
  failedLogins  Int                 @default(0)
  lockedUntil   DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   RestaurantMember[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String @unique
  userId       String
  expires      DateTime
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model RestaurantMember {
  restaurantId String
  userId       String
  role         RestaurantRole @default(WAITER)
  createdAt    DateTime       @default(now())
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([restaurantId, userId])
  @@index([userId, role])
}

model DishImageUpload {
  id           String    @id @default(cuid())
  dishId       String
  restaurantId String
  objectKey    String    @unique @db.VarChar(300)
  maxBytes     Int
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  dish         Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId, expiresAt])
}

model RestaurantInvitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @db.Char(64)
  email       String    @db.VarChar(254)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  usedAt      DateTime?
  revokedAt   DateTime?
  restaurantId String?
  @@index([email, expiresAt])
  @@index([usedAt, revokedAt, expiresAt])
}
